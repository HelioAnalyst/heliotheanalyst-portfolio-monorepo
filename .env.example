# HelioTheAnalyst Portfolio Monorepo - Environment Variables
# 
# Copy this file to .env and update with your values:
#   cp .env.example .env
#
# All values here are safe defaults for local development.

# =============================================================================
# PostgreSQL Database
# =============================================================================
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio_dev
POSTGRES_DB=portfolio
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URLs for each project (used by applications)
DATABASE_URL_SHOPIFY=postgresql+asyncpg://portfolio:portfolio_dev@localhost:5432/shopify_integration
DATABASE_URL_ORDERS=postgresql+asyncpg://portfolio:portfolio_dev@localhost:5432/order_processing
DATABASE_URL_API_TESTING=postgresql+asyncpg://portfolio:portfolio_dev@localhost:5432/api_testing

# =============================================================================
# Redis Cache & Message Broker
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# Celery broker (separate DB for Celery)
CELERY_BROKER_URL=redis://localhost:6379/1

# =============================================================================
# Shopify Integration (Optional - mock mode works without these)
# =============================================================================
# SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
# SHOPIFY_API_KEY=your_api_key
# SHOPIFY_API_PASSWORD=your_api_password
MOCK_MODE=true

# =============================================================================
# Business Central 365 (Optional)
# =============================================================================
# BC365_TENANT_ID=your_tenant
# BC365_CLIENT_ID=your_client_id
# BC365_CLIENT_SECRET=your_secret

# =============================================================================
# Order Processing
# =============================================================================
ORDER_API_PORT=8001
FLOWER_PORT=5555

# =============================================================================
# API Testing Framework
# =============================================================================
API_TESTING_PORT=8002

# =============================================================================
# HelioScraper
# =============================================================================
SELENIUM_HUB_URL=http://localhost:4444/wd/hub
SELENIUM_HEADLESS=true

# =============================================================================
# Observability (Optional)
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
