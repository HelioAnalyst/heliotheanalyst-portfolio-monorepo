# Shopify Integration System - Environment Configuration
# Copy to .env and fill in your values for real mode

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=ShopifyIntegration
DEBUG=false
LOG_LEVEL=INFO
MOCK_MODE=true

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://shopify_user:shopify_pass@localhost:5432/shopify_integration
# For sync operations (alembic, etc.)
DATABASE_URL_SYNC=postgresql://shopify_user:shopify_pass@localhost:5432/shopify_integration

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Shopify API (Optional - mock mode works without these)
# =============================================================================
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_PASSWORD=your_api_password_here
SHOPIFY_API_VERSION=2024-01

# Rate limiting
SHOPIFY_RATE_LIMIT_REQUESTS=40
SHOPIFY_RATE_LIMIT_WINDOW=1.0

# =============================================================================
# Business Central 365 (Optional - mock mode works without these)
# =============================================================================
BC365_TENANT_ID=your_tenant_id
BC365_CLIENT_ID=your_client_id
BC365_CLIENT_SECRET=your_client_secret
BC365_ENVIRONMENT=production
BC365_COMPANY_ID=your_company_id

# =============================================================================
# Sync Settings
# =============================================================================
SYNC_BATCH_SIZE=100
SYNC_MAX_RETRIES=3
SYNC_RETRY_DELAY=1.0
SYNC_TIMEOUT=30

# =============================================================================
# Monitoring
# =============================================================================
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30
